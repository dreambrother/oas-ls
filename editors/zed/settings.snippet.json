// oas-ls is opt-in: Zed does not start it for YAML by default.
// Add this to the project's .zed/settings.json (or your global settings) only
// in repositories where you want the server; listing "oas-ls" enables it.
{
  "languages": {
    "YAML": {
      "language_servers": ["oas-ls", "..."]
    }
  },
  "lsp": {
    "oas-ls": {
      // Optional: point to a locally built binary instead of relying on PATH.
      // "binary": {
      //   "path": "/home/user/.go/bin/oas-ls",
      //   "arguments": [],
      //   "env": {}
      // }
    }
  }
}
